        <mxCell id="edge-label-4" value="获得两套五步建议" style="text;html=0;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#52677c;" vertex="1" parent="1">
