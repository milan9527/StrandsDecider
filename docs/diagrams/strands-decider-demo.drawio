  <diagram id="model-comparison" name="02  Decider vs 普通大模型：本演示的实际调用流程">
    <mxGraphModel dx="1600" dy="1330" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02  Decider vs 普通大模型：本演示的实际调用流程" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;fillColor=none;strokeColor=none;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="比较相同的有限候选决策任务；普通大模型本可自由生成文本，本演示将其输出约束为同样的候选 ID。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;fillColor=none;strokeColor=none;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="input" value="应用准备输入（候选项由开发者提供）&#10;同一业务事实 state + 问题 instructions + 候选项 criteria → 相同 input_hash" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="920" height="95" as="geometry" />
        </mxCell>
        <mxCell id="left" value="A  Strands Decider · 专用决策模型" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;verticalAlign=top;align=left;fontStyle=1;dashed=1;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="710" height="655" as="geometry" />
        </mxCell>
        <mxCell id="right" value="B  普通生成式大模型 · Bedrock GPT-6.1 Sol" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#3159ac;strokeWidth=1.5;fillColor=#edf2ff;strokeColor=#9aaedf;spacing=12;verticalAlign=top;align=left;fontStyle=1;dashed=1;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="285" width="710" height="655" as="geometry" />
        </mxCell>
        <mxCell id="drequest" value="应用构造 choice 请求&#10;给定业务事实与候选动作，要求选一项" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="350" width="570" height="85" as="geometry" />
        </mxCell>
        <mxCell id="grequest" value="应用构造 Converse 请求&#10;相同业务 payload + 仅输出候选 ID JSON 的要求" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#3159ac;strokeWidth=1.5;fillColor=#edf2ff;strokeColor=#9aaedf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="350" width="570" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dinfer" value="SageMaker InvokeEndpoint → Decider v19&#10;官方 System One 模型服务 / L4 GPU&#10;GPU 租约与串行推理；独立测量每步" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ginfer" value="Bedrock Converse → GPT-6.1 Sol&#10;reasoning effort = low / maxTokens = 1024&#10;生成文本形式的决策 JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#3159ac;strokeWidth=1.5;fillColor=#edf2ff;strokeColor=#9aaedf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dresult" value="读取结构化模型响应&#10;choice + probabilities + confidence&#10;验证候选 ID、分布与响应字段" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="655" width="570" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gresult" value="解析生成的 JSON 并验证&#10;仅允许 choice，且必须属于候选列表&#10;记录输入/输出 tokens，不伪造概率" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#3159ac;strokeWidth=1.5;fillColor=#edf2ff;strokeColor=#9aaedf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="655" width="570" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dmetric" value="保留原始选择与概率&#10;记录每步耗时；GPU 按运行时间计费" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="815" width="570" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gmetric" value="保留原始选择与 token 使用量&#10;记录每步耗时；未核实单价，不估算美元成本" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#3159ac;strokeWidth=1.5;fillColor=#edf2ff;strokeColor=#9aaedf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="815" width="570" height="85" as="geometry" />
        </mxCell>
        <mxCell id="execution" value="相同的应用执行策略 · 两侧各有独立沙盒状态&#10;参考选择不同 → 仅提示，继续流程&#10;资金/结案条件不足 → 挂起或持续跟进，记录保护调整并继续" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#855116;strokeWidth=1.5;fillColor=#fff5e7;strokeColor=#ddb775;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="995" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="最终结果：五步执行记录 + 订单/工单状态 + 模拟账本 + 模板客服回复&#10;对比：同输入动作、参考一致、保护调整、每步/合计时间&#10;真实请求失败明确显示；不会用规则回放替代模型输出" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="1170" width="960" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="范围：客服文字理解与动作选择；不比较自由长文本生成、不调用真实交易工具。后端保护调整不会计作模型正确输出。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;fillColor=none;strokeColor=none;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="1280" width="1490" height="35" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#0f766e;fontFamily=Noto Sans CJK SC;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="input" target="drequest">
