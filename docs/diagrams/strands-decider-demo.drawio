  <diagram id="payment-workflow" name="03  加密支付：五步完整流程与结果">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03  加密支付：五步完整流程与结果" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;fillColor=none;strokeColor=none;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="四个场景：USDC 未到账 / USDT 少付 / 稳定币退款 / 商户结算 ｜ 全部为模拟业务数据" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;fillColor=none;strokeColor=none;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="冻结本轮证据版本&#10;客户诉求 + 到账金额 + 确认数 + 地址验证 + 人工审批 + 风险标记 + 结算状态&#10;两模型收到同一版本；每一步并发调用两模型，五步决策按顺序进行" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52677c;strokeWidth=1.5;fillColor=#f2f5f8;strokeColor=#c5cfda;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="1460" height="95" as="geometry" />
        </mxCell>
        <mxCell id="intake" value="01 客服受理&#10;选择客服队列&#10;支付 / 退款 / 商户" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="315" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="02 交易核验&#10;读取金额与确认&#10;或结算进度" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="315" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="approve" value="03 风控审批&#10;选择通过 / 复核&#10;验证地址 / 等待审批" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="315" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="04 业务处置&#10;入账 / 退款 / 对账&#10;或挂起 / 升级" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="315" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="close" value="05 回复结案&#10;选择结案或跟进&#10;供后续选择回复模板" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="315" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="plans" value="分别按序执行两套方案 · Decider 与 GPT 各自拥有独立模拟订单、工单、账本&#10;执行到每步时重新检查实际状态；原始模型选择与实际动作分别保存" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="505" width="1200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="advisory" value="参考差异：允许继续&#10;例如普通支付选择「等待人工审批」&#10;保留原始模型动作；不再卡在 2/5&#10;后续资金可挂起，客服流程继续" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#155e55;strokeWidth=1.5;fillColor=#e9f6f2;strokeColor=#72b5a5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="675" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="资金 / 结案保护：调整后继续&#10;少付入账、未审批退款 → 挂起&#10;实际业务未完成却要求结案 → 跟进&#10;记录 requested_action 与实际 action" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#855116;strokeWidth=1.5;fillColor=#fff5e7;strokeColor=#ddb775;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="675" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="调用失败：明确显示未完成&#10;模型 / 网络 / 响应校验失败不伪造结果&#10;执行请求失败可重试剩余步骤&#10;非法、乱序、重复动作仍被拒绝" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#52677c;strokeWidth=1.5;fillColor=#f2f5f8;strokeColor=#c5cfda;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="675" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="final" value="5/5 步完成 ≠ 资金业务已完成&#10;订单：待处理 / 已收款 / 模拟退款 / 已对账     工单：持续跟进 / 已结案&#10;客服回复依据实际执行状态；挂起不显示为已付款或已退款" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1c3045;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#b9c8d5;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="865" width="1280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="events" value="继续演示：模拟确认数达标 / 补足差额 / 验证地址 / 审批通过 / 结算到账 → 清除旧结果，重新开始&#10;「客服会话 → 推进模拟交易」点击事件后，显示系统通知与前后数值（如 3/12 → 12/12），保留历史回复；再重新运行。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#52677c;strokeWidth=1.5;fillColor=#f2f5f8;strokeColor=#c5cfda;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="1440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0f766e;fontColor=#0f766e;fontFamily=Noto Sans CJK SC;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.496;entryX=0.0;entryY=0.496;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="intake" target="verify">
