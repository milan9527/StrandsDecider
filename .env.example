# Configure these in your shell before starting the web app.
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_TIMEOUT=180
# Only for local HTTP development; AWS requires true.
AUTH_COOKIE_SECURE=false
AUTH_DB_PATH=.data/auth.sqlite3
# Optional real GPT-6.1 Sol comparison through the current AWS credentials.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
# Optional Jev comparison; read the key only on the backend, never in the browser.
JEV_API_KEY_FILE=
# AWS uses an IAM-only Lambda bridge with a Secrets Manager credential.
JEV_FUNCTION_NAME=
# AWS deployment configures AUTH_TABLE, AWS_REGION and AUTH_ORIGIN automatically.
# Optional model launcher configuration:
DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_DEVICE=cpu
