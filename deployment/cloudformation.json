{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Strands Decider: private S3/OAC, internal ALB, small ARM64 Fargate API with a separately managed reusable On-Demand GPU.",
  "Parameters": {
    "ImageTag": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9._-]+"
    },
    "ApiImageTag": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "[A-Za-z0-9._-]*"
    },
    "GpuStateTableName": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9._-]+"
    },
    "ModelProvider": {
      "Type": "String",
      "Default": "ec2",
      "AllowedValues": [
        "ec2",
        "sagemaker"
      ]
    },
    "JevSecretArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the Jev API key (not the key itself)."
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 4
    },
    "AvailabilityZone1": {
      "Type": "AWS::EC2::AvailabilityZone::Name"
    },
    "AvailabilityZone2": {
      "Type": "AWS::EC2::AvailabilityZone::Name"
    },
    "CloudFrontPrefixListId": {
      "Type": "String"
    }
  },
  "Conditions": {
    "HasApiImageTag": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApiImageTag"
            },
            ""
          ]
        }
      ]
    },
    "HasJev": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "JevSecretArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.78.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PrivateRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone1"
        },
        "CidrBlock": "10.78.1.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "SubnetRoute1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "Subnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone2"
        },
        "CidrBlock": "10.78.2.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "SubnetRoute2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet2"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "TaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Decider API and model task; no public ingress"
      }
    },
    "EndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Private AWS endpoints for ECS image pulls and logs",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            }
          }
        ]
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "CloudFront VPC origin to internal ALB only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8000,
            "ToPort": 8000,
            "DestinationSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            }
          }
        ]
      }
    },
    "TaskIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8000,
        "ToPort": 8000,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        }
      }
    },
    "EcrApiEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.api"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ]
      }
    },
    "EcrDockerEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.dkr"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ]
      }
    },
    "LogsEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.logs"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ]
      }
    },
    "BedrockRuntimeEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock-runtime"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "bedrock:InvokeModel",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.openai.gpt-6.1-sol"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/openai.gpt-6.1-sol"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-2::foundation-model/openai.gpt-6.1-sol"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-west-2::foundation-model/openai.gpt-6.1-sol"
                }
              ]
            }
          ]
        }
      }
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Ref": "PrivateRoutes"
          }
        ]
      }
    },
    "ApiRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Expire untagged build layers after seven days\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ModelRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${AWS::StackName}-model"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Expire untagged build layers after seven days\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AuthTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${AWS::StackName}-auth"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DynamoEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.dynamodb"
        },
        "RouteTableIds": [
          {
            "Ref": "PrivateRoutes"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:DeleteItem",
                "dynamodb:UpdateItem"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuthTable",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${GpuStateTableName}"
                }
              ]
            }
          ]
        }
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${AWS::StackName}"
        },
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PullImagesAndWriteLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ApiRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "ModelRepository",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AuthenticationStore",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "AuthTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${GpuStateTableName}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "sagemaker:InvokeEndpoint",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:endpoint/${AWS::StackName}-decider"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "bedrock:InvokeModel",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.openai.gpt-6.1-sol"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/openai.gpt-6.1-sol"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-2::foundation-model/openai.gpt-6.1-sol"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-west-2::foundation-model/openai.gpt-6.1-sol"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Fn::Sub": "${AWS::StackName}"
        }
      }
    },
    "JevLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-jev"
        },
        "RetentionInDays": 14
      },
      "Condition": "HasJev"
    },
    "JevRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "JevSecretAndLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "JevSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JevLogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "HasJev"
    },
    "JevFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-jev"
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 40,
        "Role": {
          "Fn::GetAtt": [
            "JevRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "JEV_SECRET_ARN": {
              "Ref": "JevSecretArn"
            }
          }
        },
        "Code": {
          "ZipFile": "\"\"\"IAM-only Lambda bridge to Jev; no function URL, arbitrary URL or credential in responses.\"\"\"\n\nimport http.client\nimport json\nimport os\n\nimport boto3\nfrom botocore.exceptions import BotoCoreError, ClientError\n\n_key = None\n\n\ndef handler(event, context):\n    global _key\n    connection = None\n    try:\n        if (\n            not isinstance(event, dict)\n            or set(event) != {\"model\", \"state\", \"questions\"}\n            or event[\"model\"] != \"jev-latest\"\n            or not isinstance(event[\"state\"], str)\n            or not isinstance(event[\"questions\"], dict)\n            or set(event[\"questions\"]) != {\"action\"}\n        ):\n            return {\"status\": 422}\n        question = event[\"questions\"][\"action\"]\n        if (\n            not isinstance(question, dict)\n            or set(question) != {\"type\", \"instructions\", \"criteria\"}\n            or question[\"type\"] != \"choice\"\n            or not isinstance(question[\"instructions\"], str)\n            or not isinstance(question[\"criteria\"], dict)\n            or not 2 <= len(question[\"criteria\"]) <= 24\n            or any(\n                not isinstance(k, str) or not isinstance(v, str)\n                for k, v in question[\"criteria\"].items()\n            )\n        ):\n            return {\"status\": 422}\n        body = json.dumps(event, ensure_ascii=False).encode()\n        if len(body) > 65_536:\n            return {\"status\": 413}\n        if _key is None:\n            _key = (\n                boto3.client(\"secretsmanager\")\n                .get_secret_value(SecretId=os.environ[\"JEV_SECRET_ARN\"])[\"SecretString\"]\n                .strip()\n            )\n        if not _key:\n            return {\"status\": 503}\n        connection = http.client.HTTPSConnection(\"api.typesafe.ai\", timeout=30)\n        connection.request(\n            \"POST\",\n            \"/v1/systemone\",\n            body=body,\n            headers={\"Authorization\": f\"Bearer {_key}\", \"Content-Type\": \"application/json\"},\n        )\n        response = connection.getresponse()\n        if response.status != 200:\n            if response.status in (401, 403):\n                _key = None  # Pick up a rotated credential on the next request.\n            return {\"status\": response.status}\n        raw = response.read(1_048_577)\n        if len(raw) > 1_048_576:\n            return {\"status\": 502}\n        data = json.loads(raw)\n        if not isinstance(data, dict):\n            return {\"status\": 502}\n        # Don't forward arbitrary provider metadata; the API validates the answer.\n        return {\n            \"status\": 200,\n            \"data\": {k: data[k] for k in (\"model\", \"answers\", \"usage\", \"latency_ms\") if k in data},\n        }\n    except TimeoutError:\n        return {\"status\": 504}\n    except (OSError, ValueError, KeyError, TypeError, ClientError, BotoCoreError):\n        return {\"status\": 503}\n    finally:\n        if connection:\n            connection.close()\n"
        }
      },
      "Condition": "HasJev"
    },
    "JevInvokePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "InvokeJevBridge",
        "Roles": [
          {
            "Ref": "TaskRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "lambda:InvokeFunction",
              "Resource": {
                "Fn::GetAtt": [
                  "JevFunction",
                  "Arn"
                ]
              }
            }
          ]
        }
      },
      "Condition": "HasJev"
    },
    "LambdaEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.lambda"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurityGroup"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "lambda:InvokeFunction",
              "Resource": {
                "Fn::GetAtt": [
                  "JevFunction",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "TaskRole",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "Condition": "HasJev"
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Fn::If": [
                "HasApiImageTag",
                {
                  "Fn::Sub": "${ApiRepository.RepositoryUri}:${ApiImageTag}"
                },
                {
                  "Fn::Sub": "${ApiRepository.RepositoryUri}:${ImageTag}"
                }
              ]
            },
            "Essential": true,
            "Cpu": 256,
            "Memory": 512,
            "User": "10001",
            "ReadonlyRootFilesystem": true,
